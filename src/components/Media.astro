---
// An item's image, or a text placeholder when it has none.
import { Image } from 'astro:assets';
import type { Item } from '../data/items';

interface Props {
  item: Item;
  sizes: string;
  /** Also render the 4:5 portrait image (shown by CSS when the container is portrait). */
  withPortrait?: boolean;
}

const { item, sizes, withPortrait = false } = Astro.props;
const widths = [320, 480, 720, 960, 1280];
const style = item.focus ? `--focus:${item.focus}` : undefined;
---

{
  item.img ? (
    <Image class="m-img m-land" src={item.img} alt={item.title} widths={widths} sizes={sizes} quality={70} loading="lazy" style={style} />
  ) : (
    <div class="m-ph">
      {/* TODO(images): no image for this item yet (blog cards, talks). */}
      <span class="label">{item.tag}</span>
      <b>{item.title}</b>
    </div>
  )
}
{
  withPortrait && item.portrait && (
    <Image class="m-img m-port" src={item.portrait} alt={item.title} widths={widths} sizes={sizes} quality={70} loading="lazy" style={style} />
  )
}
{item.badge && <span class="m-badge">{item.badge}</span>}

<style>
  .m-img {
    width: 100%; height: 100%; object-fit: cover;
    object-position: var(--focus, 50% 50%);
    filter: saturate(0.9) brightness(0.86);
    transition: filter 0.35s ease;
  }
  .m-ph {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; justify-content: center; gap: 8px;
    padding: 14px 16px 30px;
    background: radial-gradient(120% 90% at 85% 10%, rgba(92, 194, 242, 0.14), transparent 60%), var(--hud-card);
  }
  .m-ph .label { font-size: 9px; letter-spacing: 0.2em; color: var(--accent); }
  .m-ph b { font-weight: 400; font-size: 16px; line-height: 1.15; }
  .m-badge {
    position: absolute; top: 9px; right: 9px; z-index: 3;
    font-family: var(--font-label); font-size: 8px; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--hud-dark); background: var(--peri); padding: 4px 7px;
  }
</style>
