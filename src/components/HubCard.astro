---
import Media from './Media.astro';
import { hasLink, isExternal, type Item } from '../data/items';

interface Props {
  item: Item;
}

const { item } = Astro.props;
const Tag = hasLink(item) ? 'a' : 'div';
const attrs = hasLink(item)
  ? { href: item.href, ...(isExternal(item) ? { target: '_blank', rel: 'noopener' } : {}) }
  : { tabindex: 0 }; // TODO(talk-links): no link yet; still focusable so it can expand
---

<li class="card" data-cat={item.cat} data-search={`${item.title} ${item.desc} ${item.tag}`.toLowerCase()}>
  <Tag class="inner" {...attrs}>
    <div class="media frame">
      <Media item={item} sizes="(max-width: 820px) 66vw, 410px" />
      <h2 class="cap">{item.title}</h2>
    </div>
    <div class="det">
      <p class="tag label">{item.tag}</p>
      <p>{item.desc}</p>
      {hasLink(item) && <span class="go label">{item.link} <span aria-hidden="true">→</span></span>}
    </div>
  </Tag>
</li>

<style>
  .card { position: relative; aspect-ratio: 16 / 9; }
  .card[hidden] { display: none; }
  .inner {
    position: absolute; top: 0; left: 0; z-index: 1; width: 100%;
    display: block; background: var(--hud-dark);
    transition: width 0.3s var(--ease-out), left 0.3s var(--ease-out), box-shadow 0.3s;
  }
  /* Expand in place on hover, focus or tap, anchored to the card's own edge. */
  .card:hover .inner, .card:global(.open) .inner, .inner:focus-visible {
    z-index: 10; width: calc(var(--ex) * 100%);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
  }
  .card[data-edge='m']:hover .inner, .card[data-edge='m']:global(.open) .inner, .card[data-edge='m'] .inner:focus-visible { left: calc((1 - var(--ex)) * 50%); }
  .card[data-edge='r']:hover .inner, .card[data-edge='r']:global(.open) .inner, .card[data-edge='r'] .inner:focus-visible { left: calc((1 - var(--ex)) * 100%); }

  .media { aspect-ratio: 16 / 9; overflow: hidden; background: var(--hud-dark); }
  .media :global(.m-img) { filter: saturate(0.9) brightness(0.9); }
  .media :global(.m-ph) { padding: 22px; background: var(--hud-dark); }
  .media :global(.m-ph b) { display: none; }
  .media :global(.m-ph .label) { display: none; }
  .card:hover .media :global(.m-ph .label), .card:global(.open) .media :global(.m-ph .label), .inner:focus-visible .media :global(.m-ph .label) { display: block; }
  .card:hover .media, .card:global(.open) .media, .inner:focus-visible .media {
    border-color: var(--frame-hi); box-shadow: inset 0 0 40px rgba(92, 194, 242, 0.18);
  }
  .card:hover .media::after, .card:global(.open) .media::after { background: var(--frame-hi); }
  .card:hover .media :global(.m-img), .card:global(.open) .media :global(.m-img) { filter: none; }

  .cap {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 2;
    padding: 28px 10px 7px;
    font-size: 11px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; line-height: 1.3;
    background: linear-gradient(0deg, rgba(4,11,28,0.95), rgba(4,11,28,0.6) 60%, transparent);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .card:hover .cap, .card:global(.open) .cap, .inner:focus-visible .cap { font-size: 14px; }

  .det {
    display: flex; flex-direction: column; gap: 8px;
    max-height: 0; overflow: hidden; opacity: 0; padding: 0 14px;
    transition: max-height 0.3s ease, opacity 0.2s ease, padding 0.3s ease;
  }
  .card:hover .det, .card:global(.open) .det, .inner:focus-visible .det { max-height: 260px; opacity: 1; padding: 12px 14px 14px; }
  .tag { color: var(--accent); }
  .det p:not(.tag) { line-height: 1.48; color: var(--muted-stronger); text-wrap: pretty; }
  .go { display: flex; align-items: center; gap: 8px; min-height: 32px; font-size: 11px; letter-spacing: 0.2em; color: var(--paper); }
  .inner:hover .go { color: var(--accent); }

  @media (max-width: 820px) {
    .cap { font-size: 9px; padding: 16px 6px 5px; }
    .media :global(.m-ph) { padding: 8px; }
    .media :global(.m-ph .label) { font-size: 7px; }
    .media :global(.m-badge) { display: none; }
  }
  @media (max-width: 520px) {
    .cap { font-size: 11px; padding: 22px 8px 6px; }
    .media :global(.m-ph .label) { font-size: 9px; }
  }
</style>
