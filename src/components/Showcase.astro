---
import Media from './Media.astro';
import { hasLink, isExternal, type Item } from '../data/items';

interface Props {
  id: string;
  label: string;
  items: Item[];
}

const { id, label, items } = Astro.props;
const top = items.slice(0, 5);
const more = `/content?cat=${id}`;
const ext = (i: Item) => (isExternal(i) ? { target: '_blank', rel: 'noopener' } : {});
---

<div class="sec-show">
  <h2 class="sec-title" id={`h-${id}`}>{label}</h2>

  <!-- Desktop: main item + thumbnail column -->
  <div class="show" data-show>
    <div class="stage">
      {
        top.map((item, k) => (
          <article class="panel" hidden={k !== 0} data-k={k}>
            {hasLink(item) ? (
              <a class="feat frame" href={item.href} {...ext(item)} tabindex="-1" aria-hidden="true">
                <Media item={item} sizes="(max-width: 1100px) 60vw, 50vw" withPortrait />
              </a>
            ) : (
              <div class="feat frame">
                <Media item={item} sizes="(max-width: 1100px) 60vw, 50vw" withPortrait />
              </div>
            )}
            <div class="stage-text">
              <div>
                <p class="st-tag label">{item.tag}</p>
                <h3 class="st-title">{item.title}</h3>
                <p class="st-desc">{item.desc}</p>
              </div>
              {hasLink(item) && (
                <a class="cta label" href={item.href} {...ext(item)}>
                  {item.link} <span class="arrow" aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
    <ul class="thumbs" aria-label={`${label} items`}>
      {
        top.map((item, k) => (
          <li style={`--k:${k}`}>
            <a
              class="tile frame"
              href={hasLink(item) ? item.href : undefined}
              role={hasLink(item) ? undefined : 'button'}
              tabindex={hasLink(item) ? undefined : 0}
              aria-current={k === 0 ? 'true' : undefined}
              data-k={k}
              {...ext(item)}
            >
              <Media item={item} sizes="240px" />
              <span class="t-cap">{item.title}</span>
            </a>
          </li>
        ))
      }
      <li class="more-li">
        <a class="more-tile frame" href={more}>
          <b>More <span class="arrow" aria-hidden="true">›</span></b>
          <span class="sr-only">{label} content</span>
        </a>
      </li>
    </ul>
  </div>

  <!-- Mobile: the same top 5 as a swipeable row, then See more -->
  <div class="feed" role="region" aria-label={`${label} items, swipe for more`} tabindex="0">
    {
      top.map((item) => (
        <article class="f-card">
          <div class="f-media frame">
            <Media item={item} sizes="(max-width: 820px) 80vw, 1px" />
          </div>
          <div class="f-body">
            <p class="st-tag label">{item.tag}</p>
            <h3 class="st-title">{item.title}</h3>
            <p class="st-desc">{item.desc}</p>
            {hasLink(item) && (
              <a class="cta label" href={item.href} {...ext(item)}>
                {item.link} <span class="arrow" aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </article>
      ))
    }
    <a class="f-more frame" href={more}>
      <b>More <span class="arrow" aria-hidden="true">›</span></b>
      <span class="sr-only">{label} content</span>
    </a>
  </div>
</div>

<style>
  .sec-show {
    --pt: clamp(90px, 11vh, 116px);
    --pb: clamp(34px, 5vh, 56px);
    --gap: clamp(40px, 5vw, 96px);
    --H: min(calc(100dvh - var(--pt) - var(--pb)), calc((100vw - var(--rail) - var(--edge)) * 0.64));
    --thumb-w: calc((var(--H) - 48px) / 5 * 16 / 9);
    position: absolute; inset: 0;
    padding: var(--pt) var(--edge) var(--pb) var(--rail);
    display: flex; flex-direction: column; justify-content: center;
  }
  .sec-show::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(95deg, rgba(3,9,24,0.9) 0%, rgba(3,9,24,0.66) 30%, rgba(3,9,24,0.42) 60%, rgba(3,9,24,0.3) 100%);
  }
  .sec-title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* ---- desktop showcase ---- */
  .show { flex: none; height: var(--H); display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--gap); }
  .stage {
    min-width: 0; height: var(--H);
    opacity: 0; transform: translateX(80px);
    transition: opacity 0.6s ease, transform 0.7s var(--ease-out);
  }
  :global(.section.is-active) .stage { opacity: 1; transform: none; transition-delay: 0.1s; }
  .panel { height: 100%; display: flex; flex-direction: column; gap: 16px; }
  .panel[hidden] { display: none; }
  .feat {
    flex: none; display: block; overflow: hidden; background: var(--hud-card);
    width: var(--fw, 100%); height: var(--fh, calc(var(--H) - 200px));
    max-width: 100%;
    border-color: var(--frame-hi);
    box-shadow: inset 0 0 0 1px rgba(214,228,255,0.25), inset 0 0 40px rgba(92,194,242,0.18);
    cursor: pointer;
  }
  .feat::after { background: var(--frame-hi); }
  .feat :global(.m-img) { filter: saturate(1.05) brightness(1); }
  .feat :global(.m-ph) { padding: clamp(24px, 4vw, 56px); }
  .feat :global(.m-ph b) { font-size: clamp(28px, 3.2vw, 48px); max-width: 16ch; letter-spacing: -0.015em; }
  .feat :global(.m-ph .label) { font-size: 11px; }
  /* Portrait mode shows the 4:5 image when there is one. */
  .feat :global(.m-port) { display: none; }
  .stage.portrait .feat:has(:global(.m-port)) :global(.m-land) { display: none; }
  .stage.portrait .feat :global(.m-port) { display: block; }

  .stage-text {
    display: flex; flex-direction: column; align-items: flex-start; gap: 10px;
    min-height: 0; flex: 1; overflow: hidden;
    max-width: var(--tw, min(72ch, calc((var(--H) - 200px) * 16 / 9)));
    cursor: pointer;
  }
  .st-tag { color: var(--accent); margin-bottom: 10px; }
  .st-title {
    font-size: var(--s-half); line-height: 1.2; transition: color 0.2s;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .st-desc {
    margin-top: 6px; color: var(--muted-stronger); max-width: 58ch; text-wrap: pretty;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .stage-text:hover .st-title { color: var(--accent); }
  .cta {
    flex-shrink: 0; margin-bottom: 4px;
    display: inline-flex; align-items: center; gap: 12px;
    font-size: 11px; letter-spacing: 0.2em; color: var(--paper); white-space: nowrap;
    border-bottom: 1px solid var(--accent); padding-bottom: 5px;
    transition: gap 0.2s ease, color 0.2s ease;
  }
  .cta .arrow { color: var(--accent); }
  .cta:hover, .stage-text:hover .cta, .f-card:hover .cta { color: var(--accent); gap: 16px; }

  .thumbs {
    display: grid; height: var(--H);
    grid-template-rows: repeat(5, minmax(0, 1fr));
    grid-template-columns: var(--thumb-w) clamp(96px, 9vw, 150px);
    grid-auto-flow: column; gap: 22px 20px;
    /* Deliberate empty column between the main item and the list. */
    padding-left: max(0px, calc(var(--thumb-w) + 20px - var(--gap)));
  }
  .thumbs li { min-height: 0; }
  .tile {
    display: block; height: 100%; overflow: hidden; background: var(--hud-card); cursor: pointer;
    opacity: 0; transform: translateX(48px);
    transition: border-color 0.25s ease, box-shadow 0.25s ease, opacity 0.5s ease, transform 0.6s var(--ease-out);
  }
  :global(.section.is-active) .tile {
    opacity: 1; transform: none;
    transition-delay: 0s, 0s, calc(0.2s + var(--k) * 0.04s), calc(0.2s + var(--k) * 0.04s);
  }
  .tile:hover :global(.m-img) { filter: saturate(1.05) brightness(1); }
  .tile[aria-current='true'] {
    border-color: var(--frame-hi);
    box-shadow: inset 0 0 0 1px rgba(214,228,255,0.25), inset 0 0 30px rgba(92,194,242,0.22);
  }
  .tile[aria-current='true']::after { background: var(--frame-hi); }
  .tile[aria-current='true'] :global(.m-img) { filter: saturate(1.05) brightness(1); }
  .tile :global(.m-ph b) { display: none; }
  .t-cap {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 2;
    padding: 26px 10px 7px;
    font-size: 11px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; line-height: 1.35;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    background: linear-gradient(0deg, rgba(4,11,28,0.95) 0%, rgba(4,11,28,0.7) 55%, transparent 100%);
  }
  .more-li { grid-column: 2; grid-row: 1 / -1; min-width: 0; }
  .more-tile {
    height: 100%; display: flex; align-items: center; justify-content: center;
    padding: 12px; overflow: hidden; container-type: inline-size;
    background: linear-gradient(180deg, rgba(4,11,28,0.35), rgba(4,11,28,0.85));
    opacity: 0; transform: translateX(48px);
    transition: opacity 0.5s ease, transform 0.6s var(--ease-out), background 0.3s ease, border-color 0.25s ease;
  }
  :global(.section.is-active) .more-tile { opacity: 1; transform: none; transition-delay: 0.45s, 0.45s, 0s, 0s; }
  .more-tile:hover { background: linear-gradient(180deg, rgba(92,194,242,0.08), rgba(4,11,28,0.85)); }
  .more-tile b {
    font-weight: 400; font-size: clamp(16px, 24cqi, 44px); line-height: 1;
    text-transform: uppercase; letter-spacing: 0.06em; white-space: nowrap;
    display: flex; align-items: center; gap: 0.25em;
  }
  .more-tile .arrow { color: var(--accent); transition: transform 0.3s ease; }
  .more-tile:hover .arrow { transform: translateX(8px); }

  /* ---- mobile feed: a swipeable row of cards (hidden on desktop) ---- */
  .feed {
    display: none; gap: 12px;
    margin: 0 calc(-1 * var(--edge)); padding: 0 var(--edge) 4px;
    overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scroll-padding-inline: var(--edge);
    scrollbar-width: none;
  }
  .feed::-webkit-scrollbar { display: none; }
  .feed:focus-visible { outline-offset: -2px; }
  .f-card {
    flex: 0 0 min(82%, 360px); scroll-snap-align: start;
    display: flex; flex-direction: column; cursor: pointer;
    background: rgba(4, 11, 28, 0.82);
  }
  .f-body { display: flex; flex-direction: column; gap: 8px; padding: 14px 14px 6px; flex: 1; }
  .f-card .st-tag { margin-bottom: 0; }
  .f-card .st-title { font-size: var(--s-half); }
  .f-card .st-desc { margin-top: 0; }
  .f-card .cta { align-self: flex-start; margin-top: auto; min-height: 44px; border-bottom: 0; padding-bottom: 0; }
  .f-media { aspect-ratio: 16 / 9; overflow: hidden; background: var(--hud-card); }
  .f-media :global(.m-ph) { padding: 22px; }
  .f-media :global(.m-ph b) { font-size: 22px; max-width: 16ch; }
  .f-more {
    flex: 0 0 34%; scroll-snap-align: start;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(180deg, rgba(4,11,28,0.35), rgba(4,11,28,0.85));
  }
  .f-more b { font-weight: 400; font-size: 22px; text-transform: uppercase; letter-spacing: 0.06em; display: flex; gap: 0.25em; }
  .f-more .arrow { color: var(--accent); }

  @media (max-width: 820px) {
    .sec-show { position: relative; inset: auto; padding: 40px var(--edge); }
    .sec-show::before { background: linear-gradient(180deg, rgba(3,9,24,0.7), rgba(3,9,24,0.45)); }
    .sec-title {
      position: static; width: auto; height: auto; overflow: visible; clip: auto; white-space: normal;
      font-size: var(--s1); margin-bottom: var(--s0);
    }
    .show { display: none; }
    .feed { display: flex; }
  }
</style>

<script>
  import '../scripts/showcase.ts';
</script>
