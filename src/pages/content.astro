---
import Base from '../layouts/Base.astro';
import HubCard from '../components/HubCard.astro';
import { CATEGORIES } from '../data/categories';
import { getItems } from '../data/items';

const items = await getItems();
const chips = [{ id: 'all', label: 'All', n: items.length }, ...CATEGORIES.map((c) => ({ id: c.id, label: c.label, n: items.filter((i) => i.cat === c.id).length }))];
---

<Base title="Content hub, Will Sutton" description="Every visualisation, repo, talk and blog post by Will Sutton, searchable and filterable by topic.">
  <script is:inline>
    try { if (sessionStorage.getItem('ws-slide-in')) { document.body.classList.add('slide-in'); sessionStorage.removeItem('ws-slide-in'); } } catch (e) {}
  </script>
  <div class="wrap">
    <nav class="top" aria-label="Site">
      <a class="back label" href="/" id="back">← Back</a>
      <a class="home" href="/" aria-label="Home" title="Home">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5V21h-6v-6H9v6H3z"></path></svg>
      </a>
    </nav>
    <main>
      <h1>Content <span class="accent">hub</span></h1>
      <div class="controls">
        <label class="search">
          <span class="label">Search</span>
          <input id="q" type="search" placeholder="Titles, topics, tools…" autocomplete="off" />
        </label>
        <div class="chips" id="chips" role="group" aria-label="Filter by category">
          {
            chips.map((c) => (
              <button class="chip label" type="button" data-cat={c.id} aria-pressed={c.id === 'all' ? 'true' : 'false'}>
                <span>{c.label}</span> <i>{c.n}</i>
              </button>
            ))
          }
        </div>
      </div>
      <p class="count label" id="count" aria-live="polite">{items.length} items</p>
      <ul class="grid" id="grid">
        {items.map((item) => <HubCard item={item} />)}
      </ul>
      <p class="empty" id="empty" hidden>Nothing matches that. Try another search or filter.</p>
    </main>
  </div>
</Base>

<script>
  import '../scripts/hub.ts';
</script>

<style>
  .wrap { max-width: 1280px; margin: 0 auto; padding: var(--brand-top) var(--edge) 80px; }
  :global(.slide-in) .wrap { animation: slideIn 0.5s var(--ease-out); }
  @keyframes slideIn { from { transform: translateX(30%); opacity: 0; } to { transform: none; opacity: 1; } }

  .top { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .back { display: flex; align-items: center; min-height: 44px; font-size: 11px; color: var(--muted-stronger); }
  .home { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; }
  .back:hover, .home:hover { color: var(--accent); }

  h1 { font-size: var(--s3); line-height: 1; margin: var(--s3) 0 var(--s1); }
  .accent { color: var(--accent); }

  .controls {
    position: sticky; top: 0; z-index: 20;
    display: flex; flex-direction: column; gap: 16px;
    margin-top: -16px; padding: 16px 0 24px;
    background: var(--hud-dark);
  }
  .search { display: flex; align-items: center; gap: 12px; padding: 0 16px; min-height: 48px; max-width: 520px; }
  .search:focus-within { outline: 2px solid var(--accent); outline-offset: 0; }
  .search .label { font-size: 11px; letter-spacing: 0.2em; color: var(--accent); }
  .search input { flex: 1; min-width: 0; background: none; border: 0; outline: none; color: var(--paper); font: inherit; font-size: 17px; }
  .search input::placeholder { color: var(--muted); }

  .chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .chip {
    display: flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 16px;
    font-size: 11px; letter-spacing: 0.16em; color: var(--muted-stronger); white-space: nowrap;
  }
  .chip:hover { color: var(--accent); }
  .chip[aria-pressed='true'] { background: var(--accent); color: var(--hud-dark); }
  .chip i { opacity: 0.7; }

  .count { font-size: 11px; letter-spacing: 0.2em; color: var(--muted); margin: 24px 0 20px; }

  .grid { --ex: 1.6; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }
  .empty { padding: 60px 0; color: var(--muted-stronger); }

  @media (max-width: 820px) {
    .grid { --ex: 2.1; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    h1 { margin: var(--s2) 0 var(--s0); }
    .controls { gap: 8px; padding-bottom: 12px; }
    .search { padding: 0 12px; }
    /* One swipeable row of chips instead of four wrapped rows. */
    .chips {
      flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none;
      margin: 0 calc(-1 * var(--edge)); padding: 0 var(--edge);
    }
    .chips::-webkit-scrollbar { display: none; }
    .chip { min-height: 44px; padding: 0 14px; }
    .count { margin: 12px 0 14px; }
  }
  /* Phones: two readable columns; expanded cards span the row. */
  @media (max-width: 520px) {
    .grid { --ex: 2.05; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  }
</style>
